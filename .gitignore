# Binaries
/bin/
*.exe
*.dll
*.so
*.dylib
*.wasm

# `go build` inside an example directory drops a binary named after it.
/docs/examples/charts/charts
/docs/examples/controls/controls
/docs/examples/counter/counter
/docs/examples/create/create
/docs/examples/custom/custom
/docs/examples/files/files
/docs/examples/gallery/gallery
/docs/examples/router/router
/docs/examples/settings/settings
/docs/examples/sqlite/sqlite
/docs/examples/todo/todo
/docs/examples/windows/windows
/docs/examples/workspace/workspace

# Test & coverage
*.test
*.out
coverage.*

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local tool state (contains keys)
/identity.json

# Local Go workspace, for developing against a ggfx checkout beside this one
go.work
go.work.sum

# Benchmark baselines and runs from task bench:save and bench:compare.
/.bench/

# Task's record of the sources a task was last run on (the cli task's).
/.task/

# GoReleaser output, and the notices it puts in the Linux and Windows
# archives (cmd/ggui/release/notices.sh)
/dist/
/cmd/ggui/release/notices/
